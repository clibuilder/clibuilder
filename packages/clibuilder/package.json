{
	"name": "clibuilder",
	"version": "12.0.0",
	"description": "A CLI building library",
	"keywords": [
		"builder",
		"cli",
		"command",
		"parser"
	],
	"homepage": "https://github.com/clibuilder/clibuilder",
	"bugs": {
		"url": "https://github.com/clibuilder/clibuilder/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/clibuilder/clibuilder.git"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com",
		"url": "https://github.com/unional"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./esm/index.d.ts",
			"default": "./esm/index.js"
		},
		"./axi": {
			"types": "./esm/axi.d.ts",
			"default": "./esm/axi.js"
		},
		"./compile-cache": {
			"types": "./esm/compile_cache.d.ts",
			"default": "./esm/compile_cache.js"
		},
		"./config": {
			"types": "./esm/config/index.d.ts",
			"default": "./esm/config/index.js"
		},
		"./testing": {
			"types": "./esm/testing/index.d.ts",
			"default": "./esm/testing/index.js"
		},
		"./package.json": "./package.json"
	},
	"types": "./esm/index.d.ts",
	"files": [
		"esm",
		"src",
		"!**/*.internal.*",
		"!**/*.{accept,integrate,spec,system,test,unit}.*"
	],
	"scripts": {
		"build": "tsc",
		"build:watch": "tsc --watch",
		"clean": "rimraf .nyc_output .ts coverage esm lib libm tsconfig.tsbuildinfo",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"nuke": "run-s clean && rimraf node_modules",
		"test": "vitest run",
		"verify": "npm-run-all clean -p build coverage depcheck",
		"watch": "vitest",
		"w": "pnpm watch"
	},
	"dependencies": {
		"@toon-format/toon": "^4.1.1",
		"args-minus": "workspace:^"
	},
	"devDependencies": {
		"@repobuddy/vitest": "^3.0.1",
		"@types/js-yaml": "^4.0.5",
		"@types/node": "^24.12.2",
		"@unional/fixture": "^6.0.2",
		"@vitest/coverage-istanbul": "^4.1.11",
		"assertron": "^11.7.2",
		"clibuilder-11": "npm:clibuilder@11.5.0",
		"depcheck": "^1.4.3",
		"esbuild": "^0.20.0",
		"js-yaml": "^4.1.1",
		"npm-run-all2": "^6.2.6",
		"path-equal": "^1.2.8",
		"rimraf": "^5.0.10",
		"rolldown": "1.2.13",
		"type-plus": "8.0.0",
		"typescript": "^5.9.3",
		"valibot": "^1.5.0",
		"vitest": "^4.1.11",
		"zod": "^3.25.76",
		"zod4": "npm:zod@^4.4.3"
	},
	"peerDependencies": {
		"js-yaml": "^4.1.0"
	},
	"peerDependenciesMeta": {
		"js-yaml": {
			"optional": true
		}
	},
	"engines": {
		"node": ">= 20.19"
	}
}
