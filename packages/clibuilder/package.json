{
	"name": "clibuilder",
	"version": "11.1.1",
	"description": "A CLI building library",
	"keywords": [
		"builder",
		"cli",
		"command",
		"parser"
	],
	"homepage": "https://github.com/clibuilder/clibuilder",
	"bugs": {
		"url": "https://github.com/clibuilder/clibuilder/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/clibuilder/clibuilder.git"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com",
		"url": "https://github.com/unional"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./esm/index.d.ts",
			"import": "./esm/index.js",
			"require": "./cjs/index.js",
			"default": "./cjs/index.js"
		},
		"./compile-cache": {
			"types": "./esm/compile_cache.d.ts",
			"import": "./esm/compile_cache.js",
			"require": "./cjs/compile_cache.js",
			"default": "./cjs/compile_cache.js"
		},
		"./testing": {
			"types": "./esm/testing/index.d.ts",
			"import": "./esm/testing/index.js",
			"require": "./cjs/testing/index.js",
			"default": "./cjs/testing/index.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./cjs/index.js",
	"types": "./esm/index.d.ts",
	"files": [
		"cjs",
		"esm",
		"ts",
		"!**/*.internal.*",
		"!**/*.{accept,integrate,spec,system,test,unit}.*"
	],
	"scripts": {
		"build": "run-p build:cjs build:esm",
		"build:cjs": "esbuild ts/index.ts ts/compile_cache.ts ts/testing/index.ts --bundle --platform=node --alias:jsonc-parser=jsonc-parser/lib/esm/main.js --outdir=cjs && ncp package.cjs.json cjs/package.json",
		"build:esm": "tsc",
		"build:watch": "tsc --watch",
		"clean": "rimraf .nyc_output .ts coverage cjs esm lib libm",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"nuke": "run-s clean && rimraf node_modules",
		"test": "vitest run",
		"verify": "npm-run-all clean -p build coverage depcheck",
		"watch": "vitest",
		"w": "pnpm watch"
	},
	"dependencies": {
		"find-installed-packages": "^4.0.0",
		"js-yaml": "^4.1.1",
		"jsonc-parser": "^3.3.1",
		"pad-right": "^0.2.2",
		"search-packages": "^2.2.0",
		"standard-log": "^13.2.0",
		"standard-log-color": "^13.2.0",
		"tmp": "^0.2.7",
		"tslib": "^2.5.0",
		"type-plus": "8.0.0-beta.10",
		"wordwrap": "^1.0.0",
		"zod": "^3.22.3"
	},
	"devDependencies": {
		"@types/js-yaml": "^4.0.5",
		"@types/node": "^24.12.2",
		"@types/tmp": "^0.2.3",
		"@types/wordwrap": "github:types/wordwrap",
		"@unional/fixture": "^5.0.0",
		"@vitest/coverage-istanbul": "^4.1.11",
		"assertron": "^11.6.0",
		"async-plugin": "workspace:*",
		"bad-plugin": "workspace:*",
		"bad-plugin-no-index": "workspace:*",
		"cjs-plugin": "workspace:*",
		"clibuilder-plugin-dummy": "^1.0.1",
		"depcheck": "^1.4.3",
		"esbuild": "^0.20.0",
		"esm-plugin": "workspace:*",
		"ncp": "^2.0.0",
		"npm-run-all2": "^6.2.6",
		"path-equal": "^1.2.5",
		"plugin-two": "workspace:*",
		"rimraf": "^5.0.10",
		"tersify": "^4.0.6",
		"tslib": "^2.5.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">= 20.19"
	}
}
