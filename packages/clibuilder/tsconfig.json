{
	"compilerOptions": {
		"composite": true,
		"declaration": true,
		"declarationMap": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"newLine": "LF",
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"outDir": "esm",
		"rootDir": "src",
		"strict": true,
		"target": "ES2020",
		"types": ["node", "vitest/globals"]
	},
	"include": ["src"]
}
