{
	"name": "args-minus",
	"version": "0.0.0",
	"private": true,
	"description": "A less-is-more `parseArgs`",
	"keywords": [
		"cli",
		"command",
		"command-line",
		"commandline",
		"parser",
		"args",
		"utils"
	],
	"homepage": "https://github.com/clibuilder/clibuilder",
	"bugs": {
		"url": "https://github.com/clibuilder/clibuilder/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/clibuilder/clibuilder.git",
		"directory": "packages/args-minus"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com",
		"url": "https://github.com/unional"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		"types": "./esm/index.d.ts",
		"import": "./esm/index.js"
	},
	"files": [
		"esm",
		"src",
		"!**/*.internal.*",
		"!**/*.{accept,integrate,spec,system,test,unit}.*"
	],
	"scripts": {
		"build": "tsc",
		"build:watch": "tsc --watch",
		"clean": "rimraf .turbo coverage esm",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"nuke": "run-s clean && rimraf node_modules",
		"test": "vitest run",
		"watch": "vitest",
		"w": "pnpm watch"
	},
	"devDependencies": {
		"@repobuddy/typescript": "^2.0.0",
		"@types/node": "^24.12.2",
		"@vitest/coverage-istanbul": "^4.1.11",
		"depcheck": "^1.4.3",
		"npm-run-all2": "^6.2.6",
		"rimraf": "^5.0.10",
		"type-plus": "8.0.0-beta.10",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">= 8"
	}
}
