{
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"check": "biome check",
		"check:fix": "biome check --fix",
		"cli": "turbo run build --filter=clibuilder --output-logs=errors-only 1>&2 && node test-apps/test-cli/bin.js",
		"cli:esm": "turbo run build --filter=clibuilder --output-logs=errors-only 1>&2 && node test-apps/test-cli-esm/bin.mjs",
		"clean": "turbo run clean",
		"clibuilder": "pnpm --filter clibuilder",
		"coverage": "turbo run coverage",
		"coverage:compare": "pnpm coverage && node scripts/compare-codecov-coverage.mjs",
		"coverage:compare:test": "node --test scripts/compare-codecov-coverage.test.mjs",
		"cs": "changeset",
		"depcheck": "turbo run depcheck",
		"dev": "turbo run dev --parallel",
		"format": "biome format . --write",
		"lint": "biome lint .",
		"am": "pnpm --filter ./packages/args-minus",
		"nuke": "turbo run nuke && pnpm nuke:local",
		"nuke:local": "rimraf node_modules",
		"prepare": "husky",
		"release": "changeset publish",
		"size": "turbo run size",
		"test": "turbo run test",
		"verify": "run-p lint verify:pkg",
		"verify:pkg": "turbo run build coverage depcheck size --filter=!website",
		"version": "changeset version",
		"web": "pnpm run --filter=website"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@changesets/cli": "^3.0.3",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@repobuddy/biome": "^2.4.0",
		"@types/node": "^24.12.2",
		"husky": "^9.0.11",
		"npm-run-all2": "^8.0.4",
		"turbo": "^2.10.3"
	},
	"packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
