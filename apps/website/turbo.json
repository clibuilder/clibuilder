{
	"$schema": "https://turbo.build/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["package.json", "tsconfig.json", "astro.config.mjs", "src/**"],
			"outputs": ["dist/**", ".astro/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
