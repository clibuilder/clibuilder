{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": [
				"package.json",
				"tsconfig*.json",
				"tsdown.config.ts",
				"scripts/**",
				"typings/**",
				"src/**/*.{ts,tsx}",
				"ts/**/*.{ts,tsx}"
			],
			"outputs": ["esm/**"]
		},
		"clean": {
			"cache": false
		},
		"coverage": {
			"dependsOn": ["build"],
			"inputs": [
				"package.json",
				"tsconfig*.json",
				"vitest.config.ts",
				"typings/**",
				"fixtures/**",
				"test-fixtures/**",
				"src/**/*.{ts,tsx}",
				"ts/**/*.{ts,tsx}"
			],
			"outputs": ["coverage/**"]
		},
		"depcheck": {
			"inputs": ["$TURBO_DEFAULT$"]
		},
		"dev": {
			"cache": false
		},
		"nuke": {
			"cache": false
		},
		"size": {
			"dependsOn": ["build"]
		},
		"test": {
			"dependsOn": ["build"],
			"inputs": [
				"package.json",
				"tsconfig*.json",
				"vitest.config.ts",
				"typings/**",
				"fixtures/**",
				"test-fixtures/**",
				"src/**/*.{ts,tsx}",
				"ts/**/*.{ts,tsx}"
			]
		},
		"verify": {
			"dependsOn": ["build"],
			"cache": false
		},
		"watch": {
			"dependsOn": ["build"],
			"inputs": [
				"package.json",
				"tsconfig*.json",
				"vitest.config.ts",
				"typings/**",
				"fixtures/**",
				"test-fixtures/**",
				"src/**/*.{ts,tsx}",
				"ts/**/*.{ts,tsx}"
			]
		}
	}
}
